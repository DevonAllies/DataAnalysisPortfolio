mutate(reg_med = median(e_mort_100k, na.rm = TRUE) %>%
ungroup() %>%
mutate(
high_mort = as.integer(e_mort_100k > reg_med),
region_n = as.integer(factor(g_whoregion))
) %>%
select(high_mort, e_inc_100k, e_tbhiv_prct, c_cdr, cfr_pct, region_n, year) %>%
drop())
