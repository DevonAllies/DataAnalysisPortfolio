library(reticulate)
library(tidyverse)
library(SummarizedExperiment)
library(TCGAbiolinks)
library(DESeq2)
find.package('BiocParallel')
BiocManager::install("BiocParallel", lib = target_lib, update = TRUE, ask = FALSE)
library(reticulate)
library(tidyverse)
library(SummarizedExperiment)
library(TCGAbiolinks)
library(DESeq2)
reticulate::repl_python()
dds <- DESeqDataSetFromMatrix(countData = counts_matrix,
colData = meta_data,
design = ~ sample_type)
dds <- DESeq(dds)
res <- results(dds)
sig_genes <- subset(res, padj < 0.01 & abs(log2FoldChange) > 2)
# 3. Create the ML-ready Matrix
vsd <- vst(dds, blind = FALSE)
ml_matrix_r <- as.data.frame(t(assay(vsd)[rownames(sig_genes), ]))
# Add the labels
ml_matrix_r$target <- meta_data$sample_type
